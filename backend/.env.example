# Copie para .env e preencha. O .env nunca vai para o Git.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. No Supabase: Project Settings > Database > Connection string (URI),
# modo "Session pooler", com ?sslmode=require no final.
DATABASE_URL=postgres://usuario:senha@localhost:5432/martinho
