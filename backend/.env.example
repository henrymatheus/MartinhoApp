# Opcional em desenvolvimento: sem este arquivo, o projeto usa SQLite e DEBUG ligado.
# Em produção (Render), estas variáveis são cadastradas no painel do Render, não aqui.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Só em produção: connection string do Supabase (Connect > Session pooler),
# com ?sslmode=require no final. Sem ela, o projeto usa o SQLite local.
# DATABASE_URL=
