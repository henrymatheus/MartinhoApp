# Opcional em desenvolvimento: sem este arquivo, o projeto usa SQLite e DEBUG ligado.
# Em produção (Vercel), estas variáveis são cadastradas no painel da Vercel, não aqui.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Notificações push (aviso de novo agendamento ao barbeiro). Opcional.
# Gere com: python manage.py gerar_chaves_push
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:seu-email@exemplo.com

# Só em produção: connection string do Supabase (Connect > Transaction pooler, porta 6543),
# com ?sslmode=require no final. Sem ela, o projeto usa o SQLite local.
# DATABASE_URL=

# Só em produção: Supabase Storage, para as logos dos parceiros (Storage > Settings > S3 Connection).
# Sem elas, as logos ficam na pasta backend/media/ (só serve na sua máquina).
# SUPABASE_S3_ENDPOINT=https://<projeto>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGIAO=sa-east-1
# SUPABASE_S3_CHAVE_ID=
# SUPABASE_S3_CHAVE_SECRETA=
# SUPABASE_BUCKET=arquivos
