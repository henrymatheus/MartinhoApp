# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis no
# painel da Vercel (Settings > Environment Variables). Nunca suba o .env.local.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública ("publishable", sb_publishable_...; ou a antiga "anon").
# Pode ir para o navegador: sem login, a RLS não deixa ler nada.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta ("secret", sb_secret_...; ou a antiga "service_role").
# IGNORA a RLS: só no servidor. Nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Endereço do site (links enviados por e-mail e da página de agendamento).
# Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://martinho.vercel.app

# Notificações push (opcional). Reaproveite as chaves do Django, se houver;
# senão: npm run gerar-chaves-push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:seu-email@exemplo.com

# Só para a migração única do Django (npm run migrar:django):
# a mesma DATABASE_URL que o Django usa (Supabase > Connect > Session pooler).
DATABASE_URL=
